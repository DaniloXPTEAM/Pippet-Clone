# Modelo do .env local do PiperLine — SÓ NOMES, SEM NENHUM VALOR.
# Copie para `.env` na raiz do repositório, preencha no seu editor e NUNCA versione esse arquivo
# (o `.env` está no .gitignore). O servidor lê o `.env` na inicialização; variável já definida no
# ambiente do processo tem prioridade e o `.env` não a sobrescreve.
# Nada aqui é impresso em log, relatório, tela ou entrega: a API só informa presente/ausente.

# --- Login (Supabase / GoTrue) ---
# URL do projeto, ex.: https://SEU-PROJETO.supabase.co
SUPABASE_URL=
# Chave pública (anon/publishable). Nunca use a service_role no app.
SUPABASE_ANON_KEY=

# --- Roteador gratuito de LLM/imagem/vídeo ---
FREELLMAPI_API_KEY=
OMNIROUTER_API_KEY=

# --- Cloudflare Workers AI (token + conta) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- NovAI (aiapi-pro). O nome correto da variável no código é NOVAI_API_KEY ---
NOVAI_API_KEY=

# --- NVIDIA NIM ---
NVIDIA_API_KEY=

# --- Hugging Face (token opcional dos Spaces de lip-sync) ---
HF_TOKEN=

# --- Voz local (Windows SAPI) ---
# PIPPIT_TTS=off desliga a detecção da voz do Windows: o nó de Áudio passa a bloquear ("sem voz
# local") em vez de sintetizar. Os testes usam isso para que a regra seja igual em qualquer sistema.
# Vazio/qualquer outro valor = detecção normal (só existe voz local no Windows).
PIPPIT_TTS=
